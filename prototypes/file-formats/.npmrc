# Supply-chain hardening for npm (requires npm >= 11.10; the dev container ships npm 11.19).

# Never run package lifecycle scripts (preinstall/install/postinstall). They are the usual way a
# compromised package runs code on install. Build steps we need are run explicitly instead.
ignore-scripts=true

# Only install versions published at least 7 days ago, so a malicious release has time to be
# detected and pulled before it can reach us. Keep in sync with the Dependabot cooldown
# (.github/dependabot.yml).
min-release-age=7

# Record exact versions in package.json (no ^ or ~ ranges); the lockfile pins the full tree.
save-exact=true

# Refuse to install under an unsupported Node/npm version.
engine-strict=true

# Fail `npm audit` on high or critical findings; no funding messages.
audit-level=high
fund=false
update-notifier=false
